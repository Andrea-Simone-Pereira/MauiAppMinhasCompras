<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.RelatorioCategoriaPage"
             Title="Relatório por Categoria">

    <!-- Grid estruturando o topo, a lista expansível e o rodapé fixo -->
    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="15" RowSpacing="10">

        <!--Título do Filtro -->
        <Label Grid.Row="0" 
               Text="Filtrar Categoria:" 
               FontSize="16" 
               FontAttributes="Bold" />

        <!--  Picker para filtrar por categoria -->
        <Picker Grid.Row="1" 
                x:Name="pck_filtro_categoria" 
                Title="Selecione uma Categoria" 
                SelectedIndexChanged="pck_filtro_categoria_SelectedIndexChanged">
            <Picker.Items>
                <x:String>Todas</x:String>
                <x:String>Alimentos</x:String>
                <x:String>Higiene</x:String>
                <x:String>Limpeza</x:String>
                <x:String>Outros</x:String>
            </Picker.Items>
        </Picker>

        <!--  ListView com rolagem (Row="2" com altura '*') -->
        <ListView Grid.Row="2" 
                  x:Name="lst_produtos_categoria"
                  VerticalOptions="FillAndExpand">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid Padding="10" ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding Descricao}" 
                                       FontAttributes="Bold" 
                                       FontSize="16" />
                                <Label Text="{Binding Categoria}" 
                                       FontSize="12" 
                                       TextColor="Gray" />
                            </VerticalStackLayout>

                            <Label Grid.Column="1" 
                                   Text="{Binding Total, StringFormat='{0:C}'}" 
                                   FontAttributes="Bold" 
                                   VerticalOptions="Center" />
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  Card fixo no rodapé com o Total Gasto -->
        <Frame Grid.Row="3" 
               BackgroundColor="White" 
               CornerRadius="10" 
               Padding="15">
            <VerticalStackLayout>
                <Label Text="Total Gasto na Categoria:" 
                       HorizontalOptions="Center" 
                       FontSize="14" />
                <Label x:Name="lbl_total_categoria" 
                       Text="R$ 0,00" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       TextColor="Black" 
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Frame>

    </Grid>
</ContentPage>